{
  "name": "kr-auto-trading-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "packages/shared"
  ],
  "scripts": {
    "desktop:dev": "npm --workspace apps/desktop run dev",
    "desktop:build": "npm --workspace apps/desktop run build",
    "desktop:typecheck": "npm --workspace apps/desktop run typecheck",
    "desktop:lint": "npm --workspace apps/desktop run lint",
    "desktop:test": "npm --workspace apps/desktop run test",
    "desktop:e2e": "npm --workspace apps/desktop run e2e",
    "local-paper:bootstrap": "pwsh -NoLogo -NoProfile -File scripts/bootstrap-local-paper.ps1",
    "local-paper:start": "pwsh -NoLogo -NoProfile -File scripts/start-local-paper.ps1",
    "local-paper:worker": "pwsh -NoLogo -NoProfile -File scripts/start-local-paper.ps1 -NoDesktop",
    "local-paper:desktop": "pwsh -NoLogo -NoProfile -File scripts/start-local-paper.ps1 -Tauri",
    "local-paper:stop": "pwsh -NoLogo -NoProfile -File scripts/stop-local-paper.ps1",
    "local-paper:verify": "pwsh -NoLogo -NoProfile -File scripts/verify-local-paper.ps1",
    "local-paper:verify-desktop": "pwsh -NoLogo -NoProfile -File scripts/verify-local-paper.ps1 -RequireDesktop",
    "local-paper:verify-flow": "pwsh -NoLogo -NoProfile -File scripts/verify-local-paper.ps1 -ExerciseCommand",
    "local-paper:verify-release": "pwsh -NoLogo -NoProfile -File scripts/verify-local-paper.ps1 -RequireQualification"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
